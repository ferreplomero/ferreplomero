# =============================================================================
# Ferreplomero — variables de entorno
# Copia este archivo como `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio (ya está en .gitignore).
# =============================================================================

# --- Supabase -------------------------------------------------------------
# Panel: https://supabase.com/dashboard/project/TU-PROYECTO/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"
# Solo servidor. Nunca exponer al cliente. Da acceso total saltándose RLS.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"

# --- Aplicación ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# País por defecto de la capa intercambiable: VE | CO
NEXT_PUBLIC_DEFAULT_COUNTRY="VE"

# --- Sincronización offline-first (PowerSync) ---------------------------------
# URL de la instancia PowerSync (PowerSync Cloud o self-host). Se incrusta en el
# build (NEXT_PUBLIC_): debe estar en las variables de BUILD del despliegue.
# Vacía => la app opera solo con la base local (sin sincronizar) hasta provisionarla.
NEXT_PUBLIC_POWERSYNC_URL=""

# --- Observabilidad (wrappers propios, no-op si se dejan vacíos) --------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# --- Mensajería WhatsApp (Fase posterior) -------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Cron de tasas de cambio (minimarket) --------------------------------------
# Protege POST /api/cron/tasas (refresca BCV/Euro cada 12h). El disparador vive
# en GitHub Actions, NO en el hosting (ver .github/workflows/actualizar-tasas.yml):
# en producción es una variable de entorno del sitio en Netlify, y debe existir
# TAMBIÉN como secreto de repositorio en GitHub Actions, con el MISMO valor.
CRON_SECRET=""
