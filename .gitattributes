# Normaliza fin de línea: en el repo siempre LF, evita ruido CRLF en Windows.
* text=auto eol=lf

# Scripts que deben conservar su fin de línea nativo
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binarios: nunca tocar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# Diffs más legibles
*.ts   diff
*.tsx  diff
*.md   diff
